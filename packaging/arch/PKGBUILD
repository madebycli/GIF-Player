pkgname=noctalia-gif-player
pkgver=1.3.0
pkgrel=1
pkgdesc='Native Rust Wayland GIF overlays with optional native Noctalia 5 controls'
arch=('x86_64' 'aarch64')
url='https://github.com/madebycli/GIF-Player'
license=('LicenseRef-All-Rights-Reserved')
depends=('libxkbcommon' 'ttf-dejavu')
makedepends=('rust' 'cargo' 'pkgconf')
optdepends=('noctalia: preferred native control panels' 'fontconfig: system font selection')
provides=('gif-player' 'gif-picker' 'gif-control')
conflicts=('gif-player')
source=()
sha256sums=()

build() {
  cd "$startdir/../.."
  cargo build --release --locked
}
check() {
  cd "$startdir/../.."
  cargo test --locked
}
package() {
  cd "$startdir/../.."
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
}
